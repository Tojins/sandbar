<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Sandbar installations</title>
</head>
<body>
<h1>Sandbar installations</h1>
<ul>
{% for installation in sandbar_installations %}
<li><a href="/{{ installation.project }}/">{{ installation.project }}</a></li>
{% endfor %}
</ul>
<p id="deploy">Reading the box's last convergence…</p>
<script>
// The convergence script rewrites this file on every attempt, success or
// failure (#146), so a box stuck on an old commit says so here instead of only
// in the journal. A stale timestamp means the timer itself stopped.
fetch("{{ sandbar_deploy_status_file }}", { cache: "no-store" })
  .then(response => response.ok ? response.json() : Promise.reject(new Error(`HTTP ${response.status}`)))
  .then(status => {
    document.getElementById("deploy").textContent =
      `box on ${status.commit} · ${status.result} · checked ${status.at}`;
  })
  .catch(error => {
    document.getElementById("deploy").textContent =
      `No convergence recorded yet: ${error.message}`;
  });
</script>
</body>
</html>
