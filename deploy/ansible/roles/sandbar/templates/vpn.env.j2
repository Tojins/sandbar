# What sandbar-vpn has to know about this box, rendered from the role's
# variables so a profile and the server it dials cannot disagree (#155).
SANDBAR_VPN_DIR={{ sandbar_vpn_dir }}
SANDBAR_VPN_ENDPOINT={{ sandbar_vpn_endpoint }}
SANDBAR_VPN_PORT={{ sandbar_vpn_port }}
SANDBAR_VPN_PROTO={{ sandbar_vpn_proto }}
