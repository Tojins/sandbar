# Installed once in each installation user's systemd session (#149).
[Unit]
Description=sandbar daemon for {{ sandbar_project }}
Requires=podman.socket
After=podman.socket

[Service]
Type=simple
WorkingDirectory={{ sandbar_checkout }}
EnvironmentFile={{ sandbar_installation_dir }}/sandbar.env
# The sole pre-start action reconciles this installation's exact driver tag.
# A failed replacement removes the old stamp and exits non-zero, so systemd
# never falls through to stale bytes already on disk.
ExecStartPre=/usr/bin/node {{ sandbar_installation_dir }}/install-driver.mjs {{ sandbar_installation_driver_tag }}
ExecStart=/usr/bin/node {{ sandbar_installation_dir }}/driver/node_modules/sandbar/dist/cli.js --config {{ sandbar_installation_dir }}/sandbar.config.mjs
Restart=no
KillMode=control-group
ExitType=cgroup
TimeoutStopSec={{ sandbar_stop_timeout_sec }}

[Install]
WantedBy=default.target
