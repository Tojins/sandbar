# Installed once in each installation user's systemd session (#149).
[Unit]
Description=sandbar daemon for {{ sandbar_project }}
Requires=podman.socket
After=podman.socket

[Service]
Type=simple
WorkingDirectory={{ sandbar_checkout }}
EnvironmentFile={{ sandbar_installation_dir }}/sandbar.env
# No pre-start action: the driver is the box's build of main, flipped into place
# by the converging play (#146), so a start never installs anything.
ExecStart=/usr/bin/node {{ sandbar_driver_current }}/dist/cli.js --config {{ sandbar_installation_dir }}/sandbar.config.mjs
# The daemon exits {{ sandbar_restart_exit_status }} only after the play asked it
# to and it finished draining, which is the one exit that means "start me again
# on the new build". Every other non-zero exit — 1, 2 and 4 — stays a stop for a
# human to inspect, so `Restart=no` is deliberately kept beside this.
Restart=no
RestartForceExitStatus={{ sandbar_restart_exit_status }}
KillMode=control-group
ExitType=cgroup
TimeoutStopSec={{ sandbar_stop_timeout_sec }}

[Install]
WantedBy=default.target
