{
  "name": "sandbar",
  "version": "0.42.1",
  "description": "Self-hosted issue-tracker-driven coding agent orchestrator.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "sandbar": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "src/",
    "ui/",
    "prompts/",
    "deploy/",
    "sandbar-resolve-hook.mjs",
    "sandbar.config.example.mjs",
    "sandbar.env.example"
  ],
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "check": "tsc --noEmit",
    "test": "npm run build && vitest run",
    "prepare": "npm run build",
    "preversion": "npm run check && npm test",
    "postversion": "git push --follow-tags"
  },
  "dependencies": {
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "typescript": "^5.7.0",
    "vitest": "^4.1.5",
    "yaml": "^2.9.0"
  }
}
